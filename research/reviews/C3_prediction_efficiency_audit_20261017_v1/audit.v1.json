{
  "action_plan": [
    {
      "action": "For future replacement of serial routes, reuse the effective six-candidate scheduler and scheduled-checkpoint metadata handling. Keep already-interleaved VAL003-004 as baseline. This audit does not justify interrupting jobs or rerunning sealed cells.",
      "order": 1,
      "static_effect": "All-five raw encode_block calls change from96294 to24044; learned encoder calls remain144264. Code/plan counts only, no runtime speed ratio."
    },
    {
      "action": "Inference-only scheduler successor: full1600-leaf encode_bank, then index_select exact persistent query_column before each GRU; six independent [1,1000,32] directional states; inverse-query mapping for all focal_sample_column gathers. Retain every tree in both directions and all10000 focal rows.",
      "order": 2,
      "precision_limit": "Column independence is algebraic source evidence, not an executed numerical-equivalence result. Changed FP32 batch shapes may change kernel roundoff. Replace all1600-recurrent receipt wording truthfully with graph1600/query-recurrence1000.",
      "source_basis": "scan_context uses sample columns only as independent batch elements. Training efficient_step_v1.py:116-163 already projects complete graph contexts to exact query columns."
    },
    {
      "action": "Small observation cleanup: compute connected-tree layout once and pass it to an internal branch-support helper. Preserve public support interface and original split/tie/equations. No parent-wide graph/context cache.",
      "order": 3
    },
    {
      "action": "Defer broader kernel changes. Compact per-level routing reuse within a current bank could remove PyG arange/stack allocations, but aggregation/message order and kernel changes require separate justification. Add no full-parent learned-context cache, guard, bridge or admission layer.",
      "order": 4
    }
  ],

  "findings": [
    {
      "evidence": [
        "src/arggnn/american_c3_gnn_dataset_isolated_v2.py:145-175",
        "src/arggnn/american_c3_gnn_run_isolated_v2.py:40-69"
      ],
      "finding": "No GNN or GRU call per focal. Complete planned forest blocks are encoded per checkpoint/direction, with sparse focal gathers.",
      "id": "F1"
    },
    {
      "evidence": [
        "research/reviews/C3_saved600_artifact_acceptance_source_20261016_v1/worker_entry_v1.py:34-67",
        "research/reviews/C3_CPU_checkpoint_schema_repair_source_20261017_v1/prediction_bridge_v1.py:35-123",
        "research/reviews/C3_CPU_six_candidate_interleave_source_20261016_v1/six_candidate_scan_v1.py:92-160"
      ],
      "finding": "VAL000-002 make twelve dataset traversals per parent; VAL003-004 already make two and share each bank across six independent models. Do not propose six-candidate feature reuse as a new cache for the latter.",
      "id": "F2"
    },
    {
      "evidence": [
        "src/arggnn/american_c3_gnn_dataset_isolated_v2.py:28-92",
        "src/arggnn/american_c3_gnn_dataset_isolated_v2.py:145-160",
        "src/arggnn/american_c3_gnn_observations_isolated_v2.py:94-127",
        "src/arggnn/mutation_routed_tree_observations_v1.py:262-312"
      ],
      "finding": "Dataset _state retains tree/metadata handles and genotype mmap once per instance/PID; it does not cache encoded forests. Forward/reverse traversals rebuild native trees, donor/branch features and tensor banks. Connected-tree layout is computed twice inside encode_block: directly and again by branch_concordance_support_v1.",
      "id": "F3"
    },
    {
      "evidence": [
        "research/reviews/C3_efficient_query_GPU_cache_successor_source_20261016_v1/efficient_step_v1.py:86-115",
        "research/reviews/C3_efficient_query_GPU_cache_successor_source_20261016_v1/efficient_step_v1.py:221-278",
        "research/reviews/C3_CPU_checkpoint_schema_repair_source_20261017_v2/worker_entry_v1.py:34-36"
      ],
      "finding": "The pinned single-parent device-cache source is reached by training _backward_v1/complete_parent_step_v1, which requires training mode. It is not called by the inspected effective prediction call graph. Pin inclusion alone does not prove activation.",
      "id": "F4"
    },
    {
      "evidence": [
        "src/arggnn/american_c3_gnn_run_isolated_v2.py:17-24",
        "research/reviews/C3_CPU_six_candidate_interleave_source_20261016_v1/six_candidate_scan_v1.py:79-84",
        "research/reviews/C3_CPU_six_candidate_interleave_source_20261016_v1/six_candidate_scan_v1.py:106-155"
      ],
      "finding": "Learned encoder contexts remain checkpoint-specific. Current bounded two-pass inference deliberately recomputes them in reverse and retains only focal forward states: 1280000 bytes per checkpoint, 7680000 for six, excluding probabilities/other state. Do not share learned contexts across weights.",
      "id": "F5"
    }
  ],

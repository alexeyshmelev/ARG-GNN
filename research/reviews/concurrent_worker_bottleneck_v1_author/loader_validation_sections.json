        "lines": [
          {
            "number": 43,
            "text": "def sha(path):"
          },
          {
            "number": 44,
            "text": "    h = hashlib.sha256()"
          },
          {
            "number": 45,
            "text": "    with Path(path).open(\"rb\") as stream:"
          },
          {
            "number": 46,
            "text": "        for block in iter(lambda: stream.read(1024 * 1024), b\"\"):"
          },
          {
            "number": 47,
            "text": "            h.update(block)"
          },
          {
            "number": 48,
            "text": "    return h.hexdigest()"
          }
        ],
        "name": "sha"
      },
      {
        "lines": [
          {
            "number": 77,
            "text": "def checked(record):"
          },
          {
            "number": 78,
            "text": "    p = path(record[\"path\"])"
          },
          {
            "number": 79,
            "text": "    if p.is_symlink() or not p.is_file() or sha(p) != record[\"sha256\"]:"
          },
          {
            "number": 80,
            "text": "        raise ValueError(\"Missing/changed bound file: \" + str(p))"
          },
          {
            "number": 81,
            "text": "    return p"
          }
        ],
        "name": "checked"
      },
      {
        "lines": [
          {
            "number": 549,
            "text": "def load_bank(tile, cfg, parent, device):"
          },
          {
            "number": 550,
            "text": "    p = checked(tile[\"bank\"])"
          },
          {
            "number": 551,
            "text": "    saved = torch.load(p, map_location=\"cpu\", weights_only=False)"
          },
          {
            "number": 552,
            "text": "    if (saved[\"schema\"] != \"biological_candidate_full_age_bank_v1\""
          },
          {
            "number": 553,
            "text": "            or tile[\"exact_serialization_roundtrip_checked\"] is not True"
          },
          {
            "number": 554,
            "text": "            or tile[\"all_original_age_cache_fields_retained\"] is not True):"
          },
          {
            "number": 555,
            "text": "        raise ValueError(\"Exact full bank schema/roundtrip provenance differs\")"
          },
          {
            "number": 556,
            "text": "    # Source precomputation, eigensystem/partition validation, anchor preparation"
          },
          {
            "number": 557,
            "text": "    # and full-field roundtrip occurred before sealing this hashed artifact."
          },
          {
            "number": 558,
            "text": "    # Training reuses the fixed prepared object; no repeated eigensolve or raw"
          },
          {
            "number": 559,
            "text": "    # matrix validation is introduced into each neural forward."
          },
          {
            "number": 560,
            "text": "    prepared = saved[\"fixed_prepared\"].to(\"cpu\", dtype=torch.float32)"
          },
          {
            "number": 561,
            "text": "    if (prepared.bank.leaf_x.shape[1:] != (280,47)"
          },
          {
            "number": 562,
            "text": "            or prepared.bank.query_node_ids.numel() != 184"
          },
          {
            "number": 563,
            "text": "            or prepared.bank.query_cache.reference_ids.numel() != 96"
          },
          {
            "number": 564,
            "text": "            or prepared.num_scales != 3 or prepared.layout.anchors.numel() != 32):"
          },
          {
            "number": 565,
            "text": "        raise ValueError(\"Frozen whole-tree model bank dimensions changed\")"
          },
          {
            "number": 566,
            "text": "    nodes=parent[\"observation\"][\"nodes\"]"
          },
          {
            "number": 567,
            "text": "    if (not torch.equal(prepared.bank.query_node_ids, torch.as_tensor("
          },
          {
            "number": 568,
            "text": "            nodes[parent[\"dynamics_slots\"]].copy(),dtype=torch.long))"
          },
          {
            "number": 569,
            "text": "            or not torch.equal(prepared.bank.query_cache.reference_ids,torch.as_tensor("
          },
          {
            "number": 570,
            "text": "            nodes[parent[\"reference_slots\"]].copy(),dtype=torch.long))"
          },
          {
            "number": 571,
            "text": "            or set(prepared.bank.sample_ids.tolist()) != set(nodes.tolist())"
          },
          {
            "number": 572,
            "text": "            or prepared.bank.feature_columns != tuple(c for c in range(48) if c != 7)):"
          },
          {
            "number": 573,
            "text": "        raise ValueError(\"Prepared actual inferred identities/reference roles/features changed\")"
          },
          {
            "number": 574,
            "text": "    indexes=np.asarray(tile[\"position_indexes\"],dtype=int)"
          },
          {
            "number": 575,
            "text": "    if not np.array_equal(prepared.bank.positions.numpy(),parent[\"positions\"][indexes]/2000000):"
          },
          {
            "number": 576,
            "text": "        raise ValueError(\"Prepared original normalized2Mb readouts changed\")"
          },
          {
            "number": 577,
            "text": "    actual=torch.as_tensor(nodes[parent[\"query_slots\"]].copy(),dtype=torch.long)"
          },
          {
            "number": 578,
            "text": "    expected_flags=torch.isin(prepared.bank.sample_ids,actual).float()"
          },
          {
            "number": 579,
            "text": "    if not torch.equal(prepared.bank.leaf_x[:,:,4],expected_flags.expand_as(prepared.bank.leaf_x[:,:,4])):"
          },
          {
            "number": 580,
            "text": "        raise ValueError(\"Prepared mixed64 flag became an actual-query flag\")"
          },
          {
            "number": 581,
            "text": "    return prepared.to(device,dtype=torch.float32)"
          }
        ],
        "name": "load_bank"
      }
    ],
    "sha256": "6b3a25d0e59026cab7189032eb41221feb7d1bdf69e15f6c737a672dfb711dd3"
  },

            "number": 119,
            "text": "def _content(cert):"
          },
          {
            "number": 120,
            "text": "    return {'inputs':cert.inputs,'bank':cert.bank,'forest':cert.forest,'native_trees':cert.native_trees,"
          },
          {
            "number": 121,
            "text": "            'stored_sequence':cert.stored_sequence,'provenance':cert.provenance,'config':cert.config}"
          }
        ],
        "name": "_content"
      },
      {
        "lines": [
          {
            "number": 124,
            "text": "def validate_census_biological_certificate_v1(cert,expected_certificate_sha256):"
          },
          {
            "number": 125,
            "text": "    if not expected_certificate_sha256 or cert.certificate_sha256!=expected_certificate_sha256 or fingerprint_sha256_v1(_content(cert))!=expected_certificate_sha256:"
          },
          {
            "number": 126,
            "text": "        raise ValueError('Changed/stale native,feature,donor,cut,forest,source or role certificate')"
          },
          {
            "number": 127,
            "text": "    _config(cert.config)"
          },
          {
            "number": 128,
            "text": "    return cert"
          }
        ],
        "name": "validate_census_biological_certificate_v1"
      },
      {
        "lines": [
          {
            "number": 240,
            "text": "def forward_certified_census_biological_v1(model,cert,*,expected_certificate_sha256,control='proposed',group_permutation=None,readout_chunk_size=128):"
          },
          {
            "number": 241,
            "text": "    \"\"\"Fail closed on stale source/geometry before calling the unchanged shared GNN.\"\"\""
          },
          {
            "number": 242,
            "text": "    validate_census_biological_certificate_v1(cert,expected_certificate_sha256)"
          },
          {
            "number": 243,
            "text": "    bank=cert.bank"
          },
          {
            "number": 244,
            "text": "    if control=='permuted_groups':"
          },
          {
            "number": 245,
            "text": "        if group_permutation is None:raise ValueError('Fixed global group permutation required')"
          },
          {
            "number": 246,
            "text": "        bank=permuted_group_control_v1(bank,group_permutation)"
          },
          {
            "number": 247,
            "text": "    elif group_permutation is not None:raise ValueError('Membership permutation belongs only to its declared contrast')"
          },
          {
            "number": 248,
            "text": "    return model(cert.inputs,bank,control=control,readout_chunk_size=readout_chunk_size)"
          }
        ],
        "name": "forward_certified_census_biological_v1"
      }
    ],
    "sha256": "1e89e93a23827e15439eceaabea505c6fae088fc407b62e1fd06c71dd26460c6"
  },
  "src/arggnn/census_native_qualification_runner_v1.py": {
    "functions": [
      {
        "lines": [
          {
            "number": 231,
            "text": "def load_parent_v1(parent,bank,admission,config,reader,*,tmp_directory,native_decoder=None):"
          },
          {
            "number": 232,
            "text": "    coordinate=parent['coordinate_contract'];derived=parent['observed_sample_manifest'];source=parent['original_observed_sample_manifest']"
          },
          {
            "number": 233,
            "text": "    refs={'native':_bound(reader,admission,parent['inferred_tree']),'derived':_bound(reader,admission,derived),"
          },
          {
            "number": 234,
            "text": "      'source':_bound(reader,admission,source),'completion':_bound(reader,admission,parent['completion_provenance']),'grid':_bound(reader,admission,coordinate['fixed_grid'])}"
          },
          {
            "number": 235,
            "text": "    # Verify every parent byte record before decoding any tree, roster or grid."
          },
          {
            "number": 236,
            "text": "    data={k:reader.read(v) for k,v in refs.items()}"
          },
          {
            "number": 237,
            "text": "    original=json.loads(data['source']);rows=json.loads(data['derived']);completion=json.loads(data['completion'])"
          },
          {
            "number": 238,
            "text": "    if completion!={k:v for k,v in parent.items() if k!='completion_provenance'} or reader.record(derived['source_manifest'])!=refs['source']:raise ValueError('Derived/completion source lineage differs')"
          },
          {
            "number": 239,
            "text": "    count=sum(config['role_counts'].values());mapping=parent['sample_index_to_inferred_tree_node_id']"
          },
          {
            "number": 240,
            "text": "    if derived.get('rows')!=count or len(original)!=count or len(rows)!=count or len(mapping)!=count or [m['sample_index'] for m in mapping]!=list(range(count)):raise ValueError('Complete original ordered roster required')"
          },
          {
            "number": 241,
            "text": "    roster=[]"
          },
          {
            "number": 242,
            "text": "    for i,(raw,row,joined) in enumerate(zip(original,rows,mapping)):"
          },
          {
            "number": 243,
            "text": "        if set(raw)!=ROSTER_FIELDS or raw['sample_index']!=i or type(raw['sample_index']) is not int:raise ValueError('Observation-only source roster fields/order required')"
          },
          {
            "number": 244,
            "text": "        if set(joined)!={'sample_index','inferred_tree_node_id'} or type(joined['inferred_tree_node_id']) is not int or joined['inferred_tree_node_id']<0 or type(raw['observed_node_id']) is not int or raw['observed_node_id']<0 or type(raw['haplotype']) is not int or raw['role'] not in config['role_counts'] or type(raw['age_generations']) not in (int,float) or not math.isfinite(raw['age_generations']) or raw['age_generations']<0:raise ValueError('Explicit observed/native numeric roles and dates required')"
          },
          {
            "number": 245,
            "text": "        if raw['role']!='pure_source_reference' and (raw['observed_reference_class'] is not None or raw['age_generations']>=350.):raise ValueError('All source Q strictly younger350 with no class')"
          },
          {
            "number": 246,
            "text": "        expected=dict(raw);expected['source_observed_node_id']=expected.pop('observed_node_id');expected['inferred_tree_node_id']=joined['inferred_tree_node_id'];expected['observed_node_id']=joined['inferred_tree_node_id']"
          },
          {
            "number": 247,
            "text": "        if row!=expected:raise ValueError('Source-to-native roster attribute or identity changed')"
          },
          {
            "number": 248,
            "text": "        cls=raw['observed_reference_class']"
          },
          {
            "number": 249,
            "text": "        if raw['role']=='pure_source_reference' and (type(cls) is not int or cls not in range(4) or raw['observed_cohort']!=config['classes'][cls]):raise ValueError('Observed proxy class/cohort differs')"
          },
          {
            "number": 250,
            "text": "        if not isinstance(raw['sample_id'],str) or not raw['sample_id'] or raw['haplotype'] not in (0,1):raise ValueError('Explicit sample/haplotype ordering required')"
          },
          {
            "number": 251,
            "text": "        roster.append(ObservedSampleRoleV1(i,joined['inferred_tree_node_id'],raw['role'],raw['age_generations'],raw['observed_reference_class']))"
          },
          {
            "number": 252,
            "text": "    if not config['fixture_mode']:"
          },
          {
            "number": 253,
            "text": "        for i in range(0,count,2):"
          },
          {
            "number": 254,
            "text": "            a,b=original[i:i+2]"
          },
          {
            "number": 255,
            "text": "            if a['sample_id']!=b['sample_id'] or [a['haplotype'],b['haplotype']]!=[0,1] or any(a[k]!=b[k] for k in ('role','observed_cohort','age_generations','observed_reference_class')):raise ValueError('Original diploid subject/role/date pairing changed')"
          },
          {
            "number": 256,
            "text": "    grid=_decode_grid_v1(data['grid']);positions=grid['positions_bp'];edges=grid['bin_edges_bp']"
          },
          {
            "number": 257,
            "text": "    if (positions.dtype!=np.float64 or not np.array_equal(positions,np.arange(50.,2000000.,100.)) or not np.array_equal(edges,np.arange(0.,2000001.,100.))):raise ValueError('Original complete100bp physical grid required')"
          },
          {
            "number": 258,
            "text": "    coverage=coordinate['coverage_original_bp0'];offset=coordinate['local_to_original_offset_bp']"
          },
          {
            "number": 259,
            "text": "    if (coordinate['normalization_length_bp']!=2000000 or coordinate['original_parent_interval_bp0']!=[0,2000000]"
          },
          {
            "number": 260,
            "text": "        or coordinate['physical_coordinate_transform']!='physical_original = local_tree_position + coverage_left'"
          },
          {
            "number": 261,
            "text": "        or coordinate['uncovered_tails']!='excluded; no extrapolation' or len(coverage)!=2 or not 0<=coverage[0]<coverage[1]<=2000000 or offset!=coverage[0]):raise ValueError('Original native physical coverage transform changed')"
          },
          {
            "number": 262,
            "text": "    retained=np.flatnonzero((positions>=coverage[0])&(positions<coverage[1]))"
          },
          {
            "number": 263,
            "text": "    if coordinate['fixed_grid'].get('total')!=20000 or coordinate['retained_fixed100bp_indexes']!=retained.tolist():raise ValueError('Original retained readout ordering changed')"
          },
          {
            "number": 264,
            "text": "    post=parent['post_five_iterations']"
          },
          {
            "number": 265,
            "text": "    post_checks={'clean_tree':parent['inferred_tree']['path'],'clean_tree_sha256':parent['inferred_tree']['sha256'],'sample_index_to_inferred_tree_node_id':mapping,'observed_sample_manifest':derived,'coverage_original_bp0':coverage,'local_to_original_offset_bp':offset,'sequence_length_local_bp':coverage[1]-coverage[0],'retained_fixed100bp_indexes':retained.tolist()}"
          },
          {
            "number": 266,
            "text": "    if any(post.get(k)!=v for k,v in post_checks.items()):raise ValueError('Condition-specific native source lineage changed')"
          },
          {
            "number": 267,
            "text": "    for tile in bank['tiles']:reader.read(_bound(reader,admission,tile['whole_observed_graph']))"
          },
          {
            "number": 268,
            "text": "    if len(data['native'])>config['output_cap_bytes']//2:raise ValueError('Verified native temporary exceeds reserved evidence/temp budget')"
          },
          {
            "number": 269,
            "text": "    ts=(native_decoder(data['native']) if native_decoder else _decode_native_v1(data['native'],tmp_directory))"
          },
          {
            "number": 270,
            "text": "    if type(post.get('trees')) is not int or post['trees']!=ts.num_trees:raise ValueError('Native original tree count changed')"
          },
          {
            "number": 271,
            "text": "    if ts.sequence_length!=coverage[1]-coverage[0] or set(ts.samples())!={r.native_sample_node for r in roster}:raise ValueError('Native tree sample or physical coverage join differs')"
          },
          {
            "number": 272,
            "text": "    for r in roster:"
          },
          {
            "number": 273,
            "text": "        if float(ts.node(r.native_sample_node).time)!=r.age_generations:raise ValueError('Direct native float64 observed sample date changed')"
          },
          {
            "number": 274,
            "text": "    dynamic=[r for r in roster if r.role!='pure_source_reference'];scored=[r for r in roster if r.role=='query'];references=[r for r in roster if r.role=='pure_source_reference']"
          },
          {
            "number": 275,
            "text": "    checks={'dynamics_sample_indexes':[r.actual_id for r in dynamic],'actual_query_sample_indexes':[r.actual_id for r in scored],"
          },
          {
            "number": 276,
            "text": "      'reference_sample_indexes':[r.actual_id for r in references],'actual_query_output_indexes':[dynamic.index(r) for r in scored],"
          },
          {
            "number": 277,
            "text": "      'query_node_ids':[r.native_sample_node for r in scored],'dynamics_query_node_ids':[r.native_sample_node for r in dynamic],"
          },
          {
            "number": 278,
            "text": "      'coverage_original_bp0':coverage,'retained_fixed100bp_indexes':retained.tolist(),'positions_bp':positions[retained].tolist()}"
          },
          {
            "number": 279,
            "text": "    if any(bank.get(k)!=v for k,v in checks.items()):raise ValueError('Prepared original sample/readout/target-column ordering differs')"
          },
          {
            "number": 280,
            "text": "    lineage={'source_roster':refs['source'],'derived_roster':refs['derived'],'native_tree':refs['native'],'grid':refs['grid'],'completion':refs['completion'],"
          },
          {
            "number": 281,
            "text": "      'ordered_observed_subjects':[[r['sample_id'],r['haplotype']] for r in original],"
          },
          {
            "number": 282,
            "text": "      'scored_sample_indexes':checks['actual_query_sample_indexes'],'target_columns':checks['actual_query_output_indexes'],"
          },
          {
            "number": 283,
            "text": "      'native_float64_sample_dates':[float(ts.node(r.native_sample_node).time) for r in roster]}"
          },
          {
            "number": 284,
            "text": "    return ts,roster,positions,offset,coverage,refs,lineage"
          }
        ],
        "name": "load_parent_v1"
      },
      {
        "lines": [
          {
            "number": 301,
            "text": "def prepare_tile_v1(parent,bank,tile,loaded,admission,config,reader,*,observation_decoder=None):"
          },
          {
            "number": 302,
            "text": "    ts,roster,positions,offset,coverage,refs,lineage=loaded"
          },
          {
            "number": 303,
            "text": "    left=max(tile['tile_id']*250000.,coverage[0]);right=min((tile['tile_id']+1)*250000.,coverage[1])"
          },
          {
            "number": 304,
            "text": "    indexes=np.flatnonzero((positions>=left)&(positions<right))"
          },
          {
            "number": 305,
            "text": "    original_tree_ids=[int(t.index) for t in ts.trees() if min(float(t.interval.right)+offset,right)>max(float(t.interval.left)+offset,left)]"
          },
          {
            "number": 306,
            "text": "    dyn=[r.native_sample_node for r in roster if r.role!='pure_source_reference'];reference=[r for r in roster if r.role=='pure_source_reference'];landmarks=[]"
          },
          {
            "number": 307,
            "text": "    for cls in range(4):"
          },
          {
            "number": 308,
            "text": "        panel=[r.native_sample_node for r in reference if r.observed_reference_class==cls]"
          },
          {
            "number": 309,
            "text": "        if not panel:raise ValueError('All observed reference classes required')"
          },
          {
            "number": 310,
            "text": "        landmarks.extend(panel[i] for i in np.linspace(0,len(panel)-1,4,dtype=int))"
          },
          {
            "number": 311,
            "text": "    checks={'physical_interval_bp0':[left,right],'normalized_interval':[left/2000000.,right/2000000.],"
          },
          {
            "number": 312,
            "text": "      'original_grid_indexes':indexes.tolist(),'position_indexes':np.searchsorted(np.flatnonzero((positions>=coverage[0])&(positions<coverage[1])),indexes).tolist(),'original_tree_ids':original_tree_ids,'landmarks_observed_node_ids':landmarks,"
          },
          {
            "number": 313,
            "text": "      'all_tree_nodes_retained':True,'all280_leaves_retained':True,'mixed_query_flag':0,"
          },
          {
            "number": 314,
            "text": "      'query_dynamics':len(dyn),'pure_reference_sources':len(reference),'supervised_outputs':sum(r.role=='query' for r in roster),'mixed_latent_outputs':sum(r.role=='mixed_reference_only' for r in roster)}"
          },

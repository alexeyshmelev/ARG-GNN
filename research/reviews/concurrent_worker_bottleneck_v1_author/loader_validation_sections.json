            "text": "    def read(self,record,*,runtime_file=False):"
          },
          {
            "number": 71,
            "text": "        if set(record)!={'path','sha256'} or not _sha(record['sha256']):raise ValueError('Exact path/SHA256 record required')"
          },
          {
            "number": 72,
            "text": "        relative=self.relative(record['path']);path=self.root/relative"
          },
          {
            "number": 73,
            "text": "        if self.read_bytes is None:"
          },
          {
            "number": 74,
            "text": "            if (path.is_symlink() and not runtime_file) or not path.is_file() or path.stat().st_size>self.max_file_bytes:raise ValueError('Invalid or over-budget admitted file')"
          },
          {
            "number": 75,
            "text": "            try:path.resolve().relative_to(self.root)"
          },
          {
            "number": 76,
            "text": "            except ValueError:"
          },
          {
            "number": 77,
            "text": "                if not runtime_file:raise ValueError('File resolves outside project') from None"
          },
          {
            "number": 78,
            "text": "            data=path.read_bytes()"
          },
          {
            "number": 79,
            "text": "        else:data=self.read_bytes(relative)"
          },
          {
            "number": 80,
            "text": "        if not isinstance(data,bytes) or len(data)>self.max_file_bytes or digest_bytes_v1(data)!=record['sha256']:"
          },
          {
            "number": 81,
            "text": "            raise ValueError('Admitted source bytes changed: '+relative)"
          },
          {
            "number": 82,
            "text": "        self.evidence[relative]={'sha256':record['sha256'],'bytes':len(data)}"
          },
          {
            "number": 83,
            "text": "        return data"
          }

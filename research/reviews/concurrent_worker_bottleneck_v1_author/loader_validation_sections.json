        "lines": [
          {
            "number": 321,
            "text": "    def forward(self, inputs_by_graph: Sequence[WholeTreeEncoderInputsV1],"
          },
          {
            "number": 322,
            "text": "            bank: CensusExchangeBankV1, *, control: str = \"proposed\","
          },
          {
            "number": 323,
            "text": "            readout_chunk_size: int = 128) -> CensusTreeGNNOutputV1:"
          },
          {
            "number": 324,
            "text": "        if control not in {\"proposed\", \"eta0\", \"permuted_groups\", \"raw_diagonal\", \"local\"}:"
          },
          {
            "number": 325,
            "text": "            raise ValueError(\"Unknown H021 control\")"
          },
          {
            "number": 326,
            "text": "        if len(inputs_by_graph) != bank.layout.num_graphs or len(bank.partitions) != len(inputs_by_graph):"
          },
          {
            "number": 327,
            "text": "            raise ValueError(\"Whole-tree inputs must match every serialized observed graph\")"
          },
          {
            "number": 328,
            "text": "        queries = bank.query_ids.detach().cpu()"
          },
          {
            "number": 329,
            "text": "        references = bank.reference_ids.detach().cpu()"
          },
          {
            "number": 330,
            "text": "        if control in {\"proposed\", \"eta0\", \"raw_diagonal\"} and bank.membership_control != \"observed_census_cut\":"
          },
          {
            "number": 331,
            "text": "            raise ValueError(\"Observed H021 controls require observed census memberships\")"
          },
          {
            "number": 332,
            "text": "        for graph, (inputs, partition) in enumerate(zip(inputs_by_graph, bank.partitions)):"
          },
          {
            "number": 333,
            "text": "            lookup = dict(zip(inputs.sample_ids.tolist(), inputs.sample_nodes.tolist()))"
          },
          {
            "number": 334,
            "text": "            if (not set(queries.tolist()) <= set(lookup)"
          },
          {
            "number": 335,
            "text": "                    or not torch.equal(inputs.node_times[torch.tensor([lookup[q] for q in queries.tolist()])],"
          },
          {
            "number": 336,
            "text": "                                       partition.query_ages)):"
          },
          {
            "number": 337,
            "text": "                raise ValueError(\"Encoder queries/native ages disagree with the checked census bank\")"
          },
          {
            "number": 338,
            "text": "            tree = ObservedDatedTreeV1(inputs.parent, inputs.node_times, inputs.sample_ids, inputs.sample_nodes)"
          },
          {
            "number": 339,
            "text": "            observed = build_census_cut_partition_v1(tree, queries, references,"
          },
          {
            "number": 340,
            "text": "                queries[partition.scored_query_mask], census=partition.census,"
          },
          {
            "number": 341,
            "text": "                context_date_policy=partition.context_date_policy)"
          },
          {
            "number": 342,
            "text": "            if bank.membership_control == \"observed_census_cut\" and set(observed.group_members) != set(partition.group_members):"
          },
          {
            "number": 343,
            "text": "                raise ValueError(\"Encoder topology disagrees with observed census groups\")"
          },
          {
            "number": 344,
            "text": "            # Donor banks must have been qualified against these observed trees"
          },
          {
            "number": 345,
            "text": "            # during preparation. No Python Q-by-R MRCA loop occurs in forward."
          },
          {
            "number": 346,
            "text": "        query_context, reference_context = encode_whole_tree_contexts_v1(self.encoder, inputs_by_graph, queries, references)"
          },
          {
            "number": 347,
            "text": "        parameter = self.decoder.weight"
          },
          {
            "number": 348,
            "text": "        work_bank = bank.to(parameter.device, parameter.dtype)"
          },
          {
            "number": 349,
            "text": "        anchor = query_context[work_bank.layout.anchor_graph]"
          },
          {
            "number": 350,
            "text": "        target = query_context[work_bank.target_graph]"
          },
          {
            "number": 351,
            "text": "        anchor_reference = reference_context[work_bank.layout.anchor_graph]"
          },
          {
            "number": 352,
            "text": "        target_reference = reference_context[work_bank.target_graph]"
          },
          {
            "number": 353,
            "text": "        for layer in self.layers:"
          },
          {
            "number": 354,
            "text": "            anchor, target = layer(work_bank, anchor, anchor_reference, target, control=control,"
          },
          {
            "number": 355,
            "text": "                target_reference_context=target_reference, readout_chunk_size=readout_chunk_size)"
          },
          {
            "number": 356,
            "text": "        scored = bank.partitions[0].scored_query_mask"
          },
          {
            "number": 357,
            "text": "        if any(not torch.equal(part.scored_query_mask, scored) for part in bank.partitions):"
          },
          {
            "number": 358,
            "text": "            raise ValueError(\"Scored query roster changed across observed graphs\")"
          },
          {
            "number": 359,
            "text": "        scored_device = scored.to(device=target.device)"
          },
          {
            "number": 360,
            "text": "        logits = self.decoder(target[:, scored_device])"
          },
          {
            "number": 361,
            "text": "        if not bool(torch.isfinite(logits).all()):"
          },
          {
            "number": 362,
            "text": "            raise ValueError(\"Whole-tree GNN logits are nonfinite\")"
          },
          {
            "number": 363,
            "text": "        return CensusTreeGNNOutputV1(logits, queries[scored], anchor, target, query_context, reference_context)"
          }

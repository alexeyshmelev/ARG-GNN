          {
            "number": 66,
            "text": "def _guard(value):"
          },
          {
            "number": 67,
            "text": "    \"\"\"Read-only consumer guard, no tensor copies, reductions or RNG actions."
          },
          {
            "number": 68,
            "text": ""
          },
          {
            "number": 69,
            "text": "    Reviewed models never mutate banks. Version checks catch ordinary PyTorch"
          },
          {
            "number": 70,
            "text": "    mutation. Arbitrary .data/external-storage writes are outside this interface."
          },
          {
            "number": 71,
            "text": "    \"\"\""
          },
          {
            "number": 72,
            "text": "    if isinstance(value,torch.Tensor):"
          },
          {
            "number": 73,
            "text": "        if value.requires_grad:raise ValueError('Cached prepared bank must be fixed')"
          },
          {
            "number": 74,
            "text": "        return ('tensor',str(value.device),str(value.dtype),tuple(value.shape),tuple(value.stride()),value.storage_offset(),value.untyped_storage()._cdata,value.untyped_storage().nbytes(),value._version)"
          },
          {
            "number": 75,
            "text": "    if is_dataclass(value):return (type(value).__module__,type(value).__name__,tuple((f.name,_guard(getattr(value,f.name))) for f in fields(value)))"
          },
          {
            "number": 76,
            "text": "    if isinstance(value,dict):return ('dict',tuple((key,_guard(child)) for key,child in value.items()))"
          },
          {
            "number": 77,
            "text": "    if isinstance(value,(tuple,list)):return (type(value).__name__,tuple(_guard(child) for child in value))"
          },
          {
            "number": 78,
            "text": "    if isinstance(value,float):return ('float',value.hex())"
          },
          {
            "number": 79,
            "text": "    if value is None or isinstance(value,(str,int,bool)):return value"
          },
          {
            "number": 80,
            "text": "    raise ValueError('Unsupported prepared-bank field type')"
          }
        ],
        "name": "_guard"
      }
    ],
    "sha256": "1582c493c54e9b75dfa65c910fd6cec47fa11622ca4ae8bbb30564391a82caec"
  },

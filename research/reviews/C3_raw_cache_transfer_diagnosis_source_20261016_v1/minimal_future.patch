+def _owned_device_copy_v2(cpu,device):
+    """Drop only the redundant host clone on an explicit CUDA transfer.
+
+    PyG2.7.0 Data.__copy__ copies its store and mapping. Data.to then replaces
+    values only in that new store, allocating CUDA storage for CPU tensors.
+    CPU fallback still clones because a CPU-to-CPU .to may alias its input.
+    Full canonical CPU hashing in provider.get remains unchanged.
+    """
+    if device.type!="cuda":
+        return cpu.clone().to(device)
+    require(device.index is not None,"Explicit already-admitted CUDA device")
+    bank=copy.copy(cpu)
+    require(bank is not cpu and bank._store is not cpu._store
+            and bank._store._mapping is not cpu._store._mapping,
+            "Pinned PyG independent container/store before device conversion")
+    return bank.to(device)
 

+    try:
+        # Charged compact packet metadata is outside all worker scopes.
+        save(packet,"launch.json",dict(parent_id=parent,stage=stage,pid=proc.pid,worker_pid=proc.pid,
+            worker_process_group=proc.pid,supervisor_pid=os.getpid(),owned_process_roster=roster,
+            command=command,admission_ref=admission_ref,parent_slot=slot["index"],
+            slot_fd_inherited=True,actual_wait_pending=True,no_helper_launcher=True,
+            log_capture="bounded_RAM_until_direct_wait_and_process_group_drain"))
+        selector=selectors.DefaultSelector();selector.register(proc.stdout,selectors.EVENT_READ)
+        while selector.get_map():
+            if failure is None:
+                if time.monotonic()-started>(3600 if stage=="simulate" else 10800):failure="Stage operational walltime exceeded"
+                elif sampled_work_bytes_v2(work)>WORK_CAP:failure="Private work allowance exceeded"
+                elif datetime.now(timezone.utc)>=datetime.fromisoformat(env["ARGGNN_WAVE_STORAGE_EXPIRES"]):failure="Root admission expired"
+                if failure is not None:proc.terminate();terminate_at=time.monotonic()
+            if terminate_at is not None and proc.poll() is None and time.monotonic()-terminate_at>30:proc.kill()
+            for ready,_ in selector.select(timeout=1):
+                data=os.read(ready.fileobj.fileno(),65536)
+                if not data:selector.unregister(ready.fileobj);continue
+                amount=min(len(data),LOG_CAP-len(buffer));buffer.extend(data[:amount]);dropped+=len(data)-amount
+                if amount<len(data) and failure is None:
+                    failure="Retained log cap exceeded";proc.terminate();terminate_at=time.monotonic()
+        rc=proc.wait()
+    except BaseException as exc:
+        supervisor_error=dict(error_type=type(exc).__name__,error=str(exc))
+        failure=failure or "Supervisor capture failed; worker terminated and waited"
+        if proc.poll() is None:
+            proc.terminate()
+            try:proc.wait(timeout=30)
+            except subprocess.TimeoutExpired:proc.kill();proc.wait()
+        rc=proc.wait()
+    finally:
+        if selector is not None:selector.close()
+        proc.stdout.close()
+    return dict(pid=proc.pid,returncode=rc,operational_failure=failure,owned_process_roster=roster,
+        worker_process_group_drained=group_drained(proc.pid),buffer=buffer,dropped_log_bytes=dropped,
+        elapsed_seconds=time.monotonic()-started,supervisor_error=supervisor_error)

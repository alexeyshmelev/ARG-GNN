+def sampled_work_bytes_v2(path):
+    """Best-effort bounded live cache sample; tolerate entries removed mid-sample."""
+    total=count=0;stack=[path]
+    while stack:
+        folder=stack.pop()
+        try:
+            with os.scandir(folder) as entries:
+                for entry in entries:
+                    count+=1
+                    require(count<=50000 and not entry.is_symlink(),"Bounded private work directory required")
+                    try:
+                        if entry.is_dir(follow_symlinks=False):stack.append(Path(entry.path))
+                        else:total+=entry.stat(follow_symlinks=False).st_size
+                    except FileNotFoundError:continue
+        except FileNotFoundError:continue
+    return total
+
+

_______ test_v3_only_callable_ast_delta_is_stdlib_json_namespace_binding _______

    def test_v3_only_callable_ast_delta_is_stdlib_json_namespace_binding():
        old_tree=ast.parse((ROOT/"scripts/prepare_official_argformer_tsinfer_parent_v2.py").read_text())
        new_tree=ast.parse(Path(h.__file__).read_text())
        def definitions(tree):
            return {n.name:n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
        old,new=definitions(old_tree),definitions(new_tree)
        assert set(old)==set(new)
        for name in old:
            if name!="preparation_callable":
                assert ast.dump(old[name],include_attributes=False)==ast.dump(new[name],include_attributes=False)
        fn=copy.deepcopy(new["preparation_callable"])
        ns=next(n.value for n in ast.walk(fn) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=="ns" for t in n.targets))
        indexes=[i for i,key in enumerate(ns.keys) if isinstance(key,ast.Constant) and key.value=="json"]
        assert len(indexes)==1 and ast.unparse(ns.values[indexes[0]])=="json"
        del ns.keys[indexes[0]];del ns.values[indexes[0]]
        assert ast.dump(fn,include_attributes=False)==ast.dump(old["preparation_callable"],include_attributes=False)
        current_ns=next(n.value for n in ast.walk(new["preparation_callable"]) if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=="ns" for t in n.targets))
        values={key.value:ast.unparse(value) for key,value in zip(current_ns.keys,current_ns.values)}
        assert values["json_new"]=="authority.json_new"
>       c=h.policy();bridge,bc=h.load_bridge(c)
                               ^^^^^^^^^^^^^^^^


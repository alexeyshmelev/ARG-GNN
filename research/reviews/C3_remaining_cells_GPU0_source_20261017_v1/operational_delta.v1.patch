+    def __init__(self, cap):
+        self.cap = cap
+        self.parts = collections.deque()
+        self.kept = 0
+        self.total = 0
+
+    def add(self, data):
+        self.total += len(data)
+        self.parts.append(data)
+        self.kept += len(data)
+        while self.parts and self.kept > self.cap:
+            first = self.parts.popleft()
+            over = self.kept - self.cap
+            if len(first) > over:
+                self.parts.appendleft(first[over:])
+                self.kept -= over
+            else:
+                self.kept -= len(first)

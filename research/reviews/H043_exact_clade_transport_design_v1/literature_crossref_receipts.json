    "records": [
      {
        "DOI": "10.1093/bioinformatics/btaa614",
        "title": [
          "Information theoretic generalized Robinson\u2013Foulds metrics for comparing phylogenetic trees"
        ],
        "author": [
          {
            "ORCID": "https://orcid.org/0000-0001-5660-1727",
            "authenticated-orcid": false,
            "given": "Martin R",
            "family": "Smith",
            "sequence": "first",
            "affiliation": [
              {
                "name": "Department of Earth Sciences, Lower Mountjoy, Durham University , Durham DH1 3LE, UK"
              }

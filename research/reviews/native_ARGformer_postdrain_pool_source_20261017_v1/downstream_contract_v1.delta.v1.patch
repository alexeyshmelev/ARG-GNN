+def bind_parent_metadata_v1(record):
+    global PREP_REF,PREP_CONFIG_REF,COUNTS_REF,PREP_OUTPUT,PARENT,EXPECTED_CONFIG
+    s=read(record);q=read(s["root_stage_request_ref"]);master=read(q["master_input_ref"])

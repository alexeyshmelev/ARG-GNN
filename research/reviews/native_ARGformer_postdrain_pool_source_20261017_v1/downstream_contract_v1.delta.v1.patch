+    require(master["preparation_ref"]==row["preparation_ref"],"Original declared native parent")
+    PREP_REF=master["preparation_ref"];PREP_CONFIG_REF=master["preparation_config_ref"];COUNTS_REF=master["counts_ref"];PREP_OUTPUT=row["preparation_directory"]
+    counts=read(COUNTS_REF);EXPECTED_CONFIG=copy.deepcopy(read(ref(HERE+"/downstream_scientific_base.v1.json")))
+    EXPECTED_CONFIG["scientific_protocol"]["contrastive"]["updates"]=counts["datasets"]["contrastive/train"]["rows"]//4096

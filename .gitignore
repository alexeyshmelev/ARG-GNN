# Compact JSON receipts stay tracked, bulk pilot tensors stay on the server.
experiments/results/**/*.pt

# Full biological AP row/event receipts are retained on NFS2; compact hashed records are versioned.
/experiments/results/ancestralpaths_biological_pilot_v2/native_receipt.json
/experiments/results/ancestralpaths_biological_pilot_v2/seed*_metrics.json

# Native fit outputs remain on NFS2; version concise hashed result copies.
/results/
/experiments/results/**/*.npz
/experiments/results/**/*.npy
/experiments/results/**/*.whl
/experiments/results/**/*.conda
/experiments/results/**/*.keras

# Raw execution streams and scalar exit sentinels remain in the server evidence tree.
experiments/results/**/*.stdout
experiments/results/**/*.stderr
experiments/results/**/exit_status
experiments/results/**/*.exit
research/reviews/**/*.exit_status
